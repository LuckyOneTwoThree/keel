#!/bin/sh
# keel pre-commit hook
# 调用 check.py 校验所有项目,失败则拒绝 commit
# 安装: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#   或 Windows: copy scripts\pre-commit .git\hooks\pre-commit

REPO_ROOT=$(git rev-parse --show-toplevel)

# 尝试 python3,失败则用 python
PYTHON=$(command -v python3 2>/dev/null || command -v python 2>/dev/null)
if [ -z "$PYTHON" ]; then
    echo "⚠️  未找到 python,跳过校验(请安装 Python 3.6+)"
    exit 0
fi

"$PYTHON" "$REPO_ROOT/scripts/check.py"
rc=$?

if [ $rc -ne 0 ]; then
    echo ""
    echo "❌ check.py 校验失败,拒绝 commit"
    echo "   修复后重试,或对 draft 条目跑 pm finalize <id>"
    echo "   强制跳过(不推荐): git commit --no-verify"
    exit 1
fi

exit 0
